# Required for sending real emails (test mode is on by default)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_TEMPLATE_ID=your-template-id
INVOICE_FROM_EMAIL=invoices@yourcompany.com

# Set to false to actually send emails
# INVOICE_TEST_MODE=false

# Optional overrides
# INVOICE_OUTPUT_DIR=./output
